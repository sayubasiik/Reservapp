# Entorno: development, test o production
ENVIRONMENT=development

# Base de datos local. En producción usa PostgreSQL con ?sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reservas

# Seguridad JWT. Genera una clave aleatoria distinta para producción.
SECRET_KEY=dev-only-secret-key-with-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Proyecto
PROJECT_NAME=API de Reservas

ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=dev-only-change-before-running-seed
